[Desktop Entry]
Type=Application
Name=Linux Project Mastering Audio
GenericName=Album Mastering
GenericName[pl]=Mastering albumu
Comment=Simple mastering and loudness matching for a whole album
Comment[pl]=Prosty mastering i wyrównanie głośności całego albumu
Exec=linux-project-mastering-audio %F
TryExec=linux-project-mastering-audio
Icon=io.github.jaro.LinuxProjectMasteringAudio
Terminal=false
Categories=AudioVideo;Audio;
Keywords=mastering;loudness;LUFS;wav;album;normalize;normalizacja;głośność;
MimeType=audio/x-wav;audio/wav;audio/flac;audio/x-aiff;
StartupNotify=true
StartupWMClass=io.github.jaro.LinuxProjectMasteringAudio
SingleMainWindow=true
